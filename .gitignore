# Private hosts repository (sysadmin-hosts), cloned into hosts/ as a separate
# git repository. It holds real machine data and must never be committed here:
# this repository is public.
hosts/

# Secrets — never in the repository
*.key
*.pem
*.p12
*.pfx
*.crt
*.gpg
*.asc
*.kdbx
id_rsa*
id_ed25519*
id_ecdsa*
known_hosts
.env
.env.*
*secret*
*password*
*token*
*credential*

# Configuration backups, in case someone copies a system file here by mistake
*.bak
*.bak-*
*.orig
*.save

# Temporary diagnostic output
scratch/
tmp/
*.log
*.tmp

# Editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store

# Python cache generated by the tools in .claude/skills/
__pycache__/
*.pyc
